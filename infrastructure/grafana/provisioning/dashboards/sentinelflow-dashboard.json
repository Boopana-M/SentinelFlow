      },
      "id": 1,
      "title": "Gateway Request Rate (req/sec)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(gateway_requests_total[1m])) by (instance, method, status)",
          "legendFormat": "{{instance}} - {{method}} {{status}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Rate Limit Activity (Allowed vs Blocked)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(rate_limit_allowed_total[1m]))",
          "legendFormat": "Allowed (200)"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(rate_limit_blocked_total[1m]))",
          "legendFormat": "Blocked (429)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Gateway Request Latency (Seconds)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(gateway_request_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Latency"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(gateway_request_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "P50 Latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "Backend Health Status (1 = UP, 0 = DOWN)",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "backend_health_status",
          "legendFormat": "{{backend}}"
        }
      ]
    }
  ],
